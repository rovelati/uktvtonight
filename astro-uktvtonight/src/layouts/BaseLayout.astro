---
/**
 * BaseLayout for uktvtonight.co.uk
 * UK Freeview TV Guide
 */
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  keywords?: string;
  author?: string;
  publisher?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  keywords = "what's on tv tonight uk, tv guide tonight, freeview tv guide, on tv tonight, tonight on tv uk, british tv guide, bbc tv guide, itv guide tonight, film4 schedule tonight",
  author = "UK TV Tonight",
  publisher = "UK TV Tonight",
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://uktvtonight.co.uk';
const ogImageUrl = `${siteUrl}/icon-512.png`;

import '../styles/global.css';
---

<!doctype html>
<html lang="en-GB" class="bg-slate-950 text-slate-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="author" content={author} />
    <meta name="publisher" content={publisher} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-GB" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta http-equiv="content-language" content="en-GB" />

    <!-- UK Regional & Geo Targeting -->
    <meta name="application-name" content="UK TV Tonight" />
    <meta name="theme-color" content="#020617" />
    <meta name="geo.region" content="GB" />
    <meta name="geo.country" content="United Kingdom" />
    <meta name="geo.placename" content="United Kingdom (London, Manchester, Birmingham, Glasgow, Belfast, Cardiff)" />
    <meta name="geo.position" content="51.5074;-0.1278" />
    <meta name="ICBM" content="51.5074, -0.1278" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="UK TV Tonight" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:country_name" content="United Kingdom" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Schema.org JSON-LD Structured Data -->
    {jsonLd && (
      Array.isArray(jsonLd) ? (
        jsonLd.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    )}
  </head>

  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 selection:bg-amber-400 selection:text-slate-950">
    <slot />
  </body>
</html>
