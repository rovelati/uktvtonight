---
/**
 * Header component for UK TV Tonight
 * Navigation bar with Freeview Channels, Films, Sport, Shows, On Now, and Mood Picker
 */
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '🌙 Tonight', badge: 'Prime Time' },
  { href: '/films-tonight/', label: '🍿 Films', badge: 'IMDb ⭐' },
  { href: '/sport-tonight/', label: '🏉 Live Sport', badge: 'Freeview' },
  { href: '/shows-tonight/', label: '📺 TV Shows', badge: null },
  { href: '/on-now/', label: '🔴 On Now', badge: 'Live' },
  { href: '/tomorrow/', label: '📅 Tomorrow', badge: null },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-800 bg-slate-950/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-600 via-blue-600 to-slate-900 p-0.5 shadow-md group-hover:scale-105 transition-transform flex items-center justify-center">
          <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
            <span class="text-xl">🇬🇧</span>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-lg tracking-tight text-white group-hover:text-amber-400 transition-colors">
            UK TV <span class="text-amber-400">Tonight</span>
          </span>
          <span class="text-[10px] font-semibold tracking-wider text-slate-400 uppercase -mt-1">
            Freeview Guide • UK
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2">
        {navItems.map(item => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a 
              href={item.href}
              class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 ${
                isActive 
                  ? 'bg-amber-400 text-slate-950 shadow-sm shadow-amber-400/20' 
                  : 'text-slate-300 hover:text-white hover:bg-slate-850'
              }`}
            >
              <span>{item.label}</span>
              {item.badge && (
                <span class={`text-[9px] px-1.5 py-0.2 rounded font-extrabold ${
                  isActive 
                    ? 'bg-slate-950 text-amber-400' 
                    : item.badge === 'Live'
                      ? 'bg-red-500/20 text-red-400 border border-red-500/30 animate-pulse'
                      : 'bg-slate-800 text-slate-400'
                }`}>
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Action: Mood Picker "What to Watch" Button -->
      <div class="flex items-center gap-2">
        <button 
          type="button"
          onclick="openMoodPickerModal()"
          class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 text-xs font-extrabold shadow-md hover:shadow-amber-400/20 transition-all flex items-center gap-1.5 active:scale-95"
        >
          <span>🎲</span>
          <span class="hidden sm:inline">What to Watch</span>
          <span class="sm:hidden">Pick</span>
        </button>
      </div>

    </div>

    <!-- Mobile Sub-navigation Bar -->
    <div class="md:hidden flex items-center gap-2 overflow-x-auto py-2.5 border-t border-slate-850 scrollbar-none">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a 
            href={item.href}
            class={`px-3 py-1 rounded-lg text-xs font-bold whitespace-nowrap shrink-0 ${
              isActive 
                ? 'bg-amber-400 text-slate-950' 
                : 'bg-slate-900 text-slate-300 border border-slate-800'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>

  </div>
</header>
