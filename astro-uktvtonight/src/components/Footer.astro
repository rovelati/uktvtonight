---
/**
 * Footer component for UK TV Tonight
 */
const todayYear = new Date().getFullYear();

const INTERNATIONAL_SITES = [
  { name: 'inTVstasera.it', flag: '🇮🇹', url: 'https://www.intvstasera.it/' },
  { name: 'ProgrammeCeSoir.fr', flag: '🇫🇷', url: 'https://programmecesoir.fr/' },
  { name: 'FernsehHeute.de', flag: '🇩🇪', url: 'https://fernsehheute.de/' },
  { name: 'AussieTVTonight.com', flag: '🇦🇺', url: 'https://aussietvtonight.com/' },
  { name: 'TeleEstaNoche.es', flag: '🇪🇸', url: 'https://www.teleestanoche.es/' },
  { name: 'TVWieczor.pl', flag: '🇵🇱', url: 'https://tvwieczor.pl/' },
];
---

<footer class="mt-auto border-t border-slate-800 bg-slate-950 py-12 text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🇬🇧</span>
          <span class="text-base font-extrabold text-white">UK TV Tonight</span>
        </div>
        <p class="text-slate-400 text-xs leading-relaxed max-w-sm">
          The UK's fastest and cleanest Freeview TV guide. Complete prime-time schedules for BBC One, BBC Two, ITV1, Channel 4, Channel 5, Film4, and all digital channels across the United Kingdom.
        </p>
        <p class="text-[11px] text-slate-500 mt-3">
          Broadcast times are shown in London local time (GMT/BST).
        </p>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Guide Sections</h4>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Tonight's TV (7pm - 11pm)</a></li>
          <li><a href="/films-tonight/" class="hover:text-amber-400 transition-colors">Films Tonight (IMDb Rated)</a></li>
          <li><a href="/sport-tonight/" class="hover:text-amber-400 transition-colors">Live Sport on Freeview</a></li>
          <li><a href="/shows-tonight/" class="hover:text-amber-400 transition-colors">British TV Shows & Soaps</a></li>
          <li><a href="/on-now/" class="hover:text-amber-400 transition-colors">On Now & Next</a></li>
          <li><a href="/tomorrow/" class="hover:text-amber-400 transition-colors">Tomorrow's Guide</a></li>
        </ul>
      </div>

      <!-- Freeview Channels -->
      <div>
        <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Top UK Channels</h4>
        <ul class="space-y-2">
          <li><a href="/bbc-one/" class="hover:text-amber-400 transition-colors">BBC One (CH 1)</a></li>
          <li><a href="/bbc-two/" class="hover:text-amber-400 transition-colors">BBC Two (CH 2)</a></li>
          <li><a href="/itv1/" class="hover:text-amber-400 transition-colors">ITV1 (CH 3)</a></li>
          <li><a href="/channel-4/" class="hover:text-amber-400 transition-colors">Channel 4 (CH 4)</a></li>
          <li><a href="/channel-5/" class="hover:text-amber-400 transition-colors">Channel 5 (CH 5)</a></li>
          <li><a href="/film4/" class="hover:text-amber-400 transition-colors">Film4 (CH 14)</a></li>
        </ul>
      </div>

    </div>

    <!-- International TV Guides -->
    <div class="mb-8 pt-6 border-t border-slate-900">
      <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">International TV Guides</h4>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-xs" aria-label="International TV Guides">
        {INTERNATIONAL_SITES.map(site => (
          <a href={site.url} class="inline-flex items-center gap-1.5 hover:text-amber-400 transition-colors">
            <span>{site.flag}</span>
            <span>{site.name}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
      <div>
        © {todayYear} UK TV Tonight (uktvtonight.co.uk). All rights reserved. Freeview logos and program trademarks belong to their respective broadcasters.
      </div>
      <div class="flex items-center gap-4">
        <a href="/privacy/" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="/terms/" class="hover:text-slate-400 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
