---
/**
 * BookmarkButton component for pinning favourite UK channels
 */
interface Props {
  channelSlug: string;
}

const { channelSlug } = Astro.props;
---

<button
  type="button"
  class="bookmark-btn p-1.5 rounded-lg text-slate-400 hover:text-amber-400 hover:bg-slate-800 transition-colors"
  data-channel-slug={channelSlug}
  title="Add to Favourites"
  aria-label="Add to Favourites"
>
  <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
  </svg>
</button>

<script is:inline>
  function initBookmarks() {
    const saved = JSON.parse(localStorage.getItem('uk_favourite_channels') || '[]');
    document.querySelectorAll('.bookmark-btn').forEach(btn => {
      const slug = btn.getAttribute('data-channel-slug');
      if (saved.includes(slug)) {
        btn.classList.add('text-amber-400', 'fill-amber-400');
        const svg = btn.querySelector('svg');
        if (svg) svg.classList.remove('fill-none');
      }
      
      btn.onclick = (e) => {
        e.stopPropagation();
        let favs = JSON.parse(localStorage.getItem('uk_favourite_channels') || '[]');
        if (favs.includes(slug)) {
          favs = favs.filter(s => s !== slug);
          btn.classList.remove('text-amber-400', 'fill-amber-400');
          btn.querySelector('svg')?.classList.add('fill-none');
        } else {
          favs.push(slug);
          btn.classList.add('text-amber-400', 'fill-amber-400');
          btn.querySelector('svg')?.classList.remove('fill-none');
        }
        localStorage.setItem('uk_favourite_channels', JSON.stringify(favs));
      };
    });
  }
  document.addEventListener('DOMContentLoaded', initBookmarks);
</script>
