---
/**
 * Tomorrow's TV Guide — UK TV Tonight
 * Highly searched UK query: what's on tv tomorrow uk, tomorrow's tv guide freeview
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import MoodPickerModal from '../components/MoodPickerModal.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTomorrowInUK, formatDateUK, getUKHour } from '../utils/timeSlots';
import { normCid } from '../utils/channelSlug';
import { MAJOR_UK_ORDER, filterRealPrograms } from '../utils/channelFilters';
import type { Channel, Program } from '../types';

const tomorrow = getTomorrowInUK();
const dateLabel = formatDateUK(tomorrow);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(tomorrow),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCid(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = normCid(ch.id);
    const allChPrograms = programsByChannel.get(slug) ?? [];
    const realChPrograms = filterRealPrograms(allChPrograms);
    if (realChPrograms.length === 0) continue;

    // Filter Prime Time (from 19:00 onwards in London time)
    const eveningPrograms = realChPrograms
      .filter(p => {
        const hour = getUKHour(p.start_time);
        return hour >= 19 || hour <= 2;
      })
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

    if (eveningPrograms.length > 0) {
      channelsWithPrograms.push({ ...ch, programs: eveningPrograms, slug });
    }
  }

  channelsWithPrograms.sort((a, b) => {
    const ai = MAJOR_UK_ORDER.indexOf(a.slug);
    const bi = MAJOR_UK_ORDER.indexOf(b.slug);
    if (ai !== -1 && bi !== -1) return ai - bi;
    if (ai !== -1) return -1;
    if (bi !== -1) return 1;
    return (a.number || 999) - (b.number || 999);
  });
} catch (err) {
  console.error('[tomorrow.astro] Error rendering tomorrow page:', err);
}

const pageTitle = "What's on TV Tomorrow in the UK | Freeview TV Guide";
const pageDesc = `Tomorrow's TV guide for the UK (${dateLabel}). Complete schedules for BBC One, BBC Two, ITV1, Channel 4, Channel 5, and Film4 prime-time films.`;
const keywords = "what's on tv tomorrow uk, tomorrow's tv guide, freeview tomorrow schedule, bbc one tomorrow, itv1 tomorrow, film4 tomorrow";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `What's on TV Tomorrow in the UK (${dateLabel})`,
  "inLanguage": "en-GB",
  "spatialCoverage": {
    "@type": "Country",
    "name": "United Kingdom",
    "identifier": "GB"
  }
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero Headline -->
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold mb-3">
          <span>📅 Tomorrow's Lineup</span>
          <span>•</span>
          <span>{dateLabel}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          What's on TV <span class="text-blue-400">Tomorrow</span> in the UK
        </h1>
        <p class="text-base text-slate-400 mt-2 max-w-2xl">
          Tomorrow night's prime-time schedules for all Freeview channels in England, Scotland, Wales, and Northern Ireland.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a 
          href="/" 
          class="px-4 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-bold transition-colors"
        >
          🌙 Tonight's Guide
        </a>
      </div>
    </div>

    <!-- Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {channelsWithPrograms.map(ch => (
        <ChannelCard 
          channel={ch} 
          programs={ch.programs} 
          slug={ch.slug} 
        />
      ))}
    </div>

  </main>

  <ProgramOverlay />
  <MoodPickerModal />
  <Footer />
</BaseLayout>
