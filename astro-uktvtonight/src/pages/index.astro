---
/**
 * Homepage — UK TV Tonight (uktvtonight.co.uk)
 * Prime-Time TV Guide for the United Kingdom.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import MoodPickerModal from '../components/MoodPickerModal.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInUK, formatDateUK, getUKHour } from '../utils/timeSlots';
import { normCid } from '../utils/channelSlug';
import { MAJOR_UK_ORDER, filterRealPrograms } from '../utils/channelFilters';
import type { Channel, Program } from '../types';

const today = getTodayInUK();
const dateLabel = formatDateUK(today);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCid(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = normCid(ch.id);
    const allChPrograms = programsByChannel.get(slug) ?? [];
    const realChPrograms = filterRealPrograms(allChPrograms);
    if (realChPrograms.length === 0) continue;

    // Filter Prime Time (from 19:00 onwards in London time)
    const eveningPrograms = realChPrograms
      .filter(p => {
        const hour = getUKHour(p.start_time);
        return hour >= 19 || hour <= 2;
      })
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

    if (eveningPrograms.length > 0) {
      channelsWithPrograms.push({ ...ch, programs: eveningPrograms, slug });
    }
  }

  // Sort channels by Major UK Freeview LCN order
  channelsWithPrograms.sort((a, b) => {
    const ai = MAJOR_UK_ORDER.indexOf(a.slug);
    const bi = MAJOR_UK_ORDER.indexOf(b.slug);
    if (ai !== -1 && bi !== -1) return ai - bi;
    if (ai !== -1) return -1;
    if (bi !== -1) return 1;
    return (a.number || 999) - (b.number || 999);
  });
} catch (err) {
  console.error('[index.astro] Error rendering UK homepage:', err);
}

const pageTitle = "What's on TV Tonight in the UK | Freeview TV Guide";
const pageDesc = "Complete UK TV guide for tonight. Find prime time schedules, movies on Film4, soaps, and live sport across BBC One, BBC Two, ITV1, Channel 4, Channel 5, and all Freeview channels.";
const keywords = "what's on tv tonight uk, tv guide tonight, freeview tv guide, on tv tonight, bbc tv guide, itv guide tonight, film4 schedule tonight, british tv guide";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "What's on TV Tonight in the UK",
  "description": pageDesc,
  "inLanguage": "en-GB",
  "spatialCoverage": {
    "@type": "Country",
    "name": "United Kingdom",
    "identifier": "GB"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United Kingdom",
    "identifier": "GB"
  },
  "itemListElement": channelsWithPrograms.slice(0, 15).map((ch, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "BroadcastService",
      "name": ch.name,
      "broadcastChannelId": String(ch.number),
      "url": `https://uktvtonight.co.uk/${ch.slug}/`
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero / Headline Bar -->
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold mb-3">
          <span>🇬🇧 Freeview UK</span>
          <span>•</span>
          <span>{dateLabel}</span>
          <span>•</span>
          <span class="text-purple-400 font-bold">Watershed at 21:00</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          What's on TV <span class="text-amber-400">Tonight</span> in the UK
        </h1>
        <p class="text-base text-slate-400 mt-2 max-w-2xl">
          Tonight's prime-time Freeview schedules for BBC One, BBC Two, ITV1, Channel 4, Channel 5, Film4, and top digital networks.
        </p>
      </div>

      <!-- Quick Category Hub Filters -->
      <div class="flex items-center gap-2 flex-wrap">
        <a 
          href="/films-tonight/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors flex items-center gap-1.5"
        >
          <span>🍿</span>
          <span>Films (⭐ IMDb)</span>
        </a>
        <a 
          href="/sport-tonight/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors flex items-center gap-1.5"
        >
          <span>🏉</span>
          <span>Live Sport</span>
        </a>
        <a 
          href="/shows-tonight/" 
          class="px-4 py-2 rounded-xl bg-slate-850 hover:bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold transition-colors flex items-center gap-1.5"
        >
          <span>📺</span>
          <span>TV Shows</span>
        </a>
        <a 
          href="/on-now/" 
          class="px-4 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 text-red-400 text-xs font-bold transition-colors flex items-center gap-1.5"
        >
          <span class="w-2 h-2 rounded-full bg-red-400 animate-pulse"></span>
          <span>On Now</span>
        </a>
      </div>
    </div>

    <!-- Freeview Channel Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {channelsWithPrograms.map(ch => (
        <ChannelCard 
          channel={ch} 
          programs={ch.programs} 
          slug={ch.slug} 
        />
      ))}
    </div>

  </main>

  <ProgramOverlay />
  <MoodPickerModal />
  <Footer />
</BaseLayout>
