---
/**
 * Channel Schedule Page — UK TV Tonight
 * Dynamic route for each Freeview channel: /bbc-one/, /itv1/, /film4/, etc.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import MoodPickerModal from '../components/MoodPickerModal.astro';
import BookmarkButton from '../components/BookmarkButton.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInUK, formatDateUK, formatTimeUK, isCurrentBroadcastDay, isWatershed } from '../utils/timeSlots';
import { normCid } from '../utils/channelSlug';
import { filterRealPrograms } from '../utils/channelFilters';
import { getFallbackImageForProgram, getCleanProgramImage } from '../utils/programImages';
import type { Channel, Program } from '../types';

export async function getStaticPaths() {
  const channels = await fetchChannels();
  return channels.map(ch => ({
    params: { sender: normCid(ch.id) },
    props: { channel: ch },
  }));
}

interface Props {
  channel: Channel;
}

const { channel } = Astro.props;
const slug = normCid(channel.id);
const today = getTodayInUK();
const dateLabel = formatDateUK(today);

let programs: Program[] = [];

try {
  const allPrograms = await fetchProgramsForDate(today);
  const chPrograms = allPrograms.filter(p => normCid(p.channel_id ?? '') === slug);
  programs = filterRealPrograms(chPrograms).sort(
    (a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime()
  );
} catch (err) {
  console.error(`[[sender].astro] Error fetching programs for ${slug}:`, err);
}

const pageTitle = `${channel.name} TV Guide Tonight (CH ${channel.number}) | Freeview Schedule`;
const pageDesc = `Full Freeview TV guide and schedule for ${channel.name} (Channel ${channel.number}) today, ${dateLabel}. Catch up on ${channel.bvodPlatform || 'Freeview'} with program synopses and times.`;
const keywords = `${channel.name} tv guide tonight, ${channel.name} schedule, freeview channel ${channel.number}, what's on ${channel.name} tonight, ${channel.name} listings`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BroadcastService",
  "name": channel.name,
  "broadcastChannelId": String(channel.number),
  "url": `https://uktvtonight.co.uk/${slug}/`,
  "inLanguage": "en-GB",
  "areaServed": {
    "@type": "Country",
    "name": "United Kingdom",
    "identifier": "GB"
  },
  "hasBroadcastEvent": programs.slice(0, 15).map(prog => ({
    "@type": "BroadcastEvent",
    "name": prog.title,
    "description": prog.description,
    "startDate": prog.start_time,
    "endDate": prog.end_time,
    "inLanguage": "en-GB"
  }))
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header />

  <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Channel Hero Header -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 mb-8 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-5">
        <div class="w-20 h-16 bg-slate-950 rounded-2xl p-2.5 flex items-center justify-center border border-slate-800 shadow-md">
          <img 
            src={channel.logo} 
            alt={channel.name} 
            class="max-h-full max-w-full object-contain"
          />
        </div>
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono font-bold bg-amber-400 text-slate-950 px-2 py-0.5 rounded">
              FREEVIEW CH {channel.number}
            </span>
            <BookmarkButton channelSlug={slug} />
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white">
            {channel.name} TV Guide
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            {dateLabel} • {channel.bvodPlatform || 'Free-to-Air'}
          </p>
        </div>
      </div>

      <!-- Action: Watch on BVOD Player -->
      {channel.streamUrl && (
        <a 
          href={channel.streamUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-3 rounded-2xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs sm:text-sm transition-all shadow-lg flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
          <span>Watch on {channel.bvodPlatform || 'Live TV'}</span>
          <span>↗</span>
        </a>
      )}
    </div>

    <!-- Programme Schedule Timeline -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
      <div class="p-4 sm:p-6 border-b border-slate-800 bg-slate-850/50 flex items-center justify-between">
        <span class="text-sm font-bold text-slate-200">
          Full Schedule ({programs.length} programmes)
        </span>
        <a href="/" class="text-xs font-bold text-amber-400 hover:underline">
          ← All Freeview Channels
        </a>
      </div>

      <div class="divide-y divide-slate-800/60">
        {programs.length === 0 ? (
          <div class="p-12 text-center text-slate-500">
            No listings available for this channel today.
          </div>
        ) : (
          programs.map(prog => {
            const timeFormatted = formatTimeUK(prog.start_time);
            const endTimeFormatted = formatTimeUK(prog.end_time);
            const cleanImg = getCleanProgramImage(prog.image_url, prog.title, prog.category);
            const fallbackImg = getFallbackImageForProgram(prog.title, prog.category);
            const watershed = isWatershed(prog.start_time);

            return (
              <div 
                class="p-4 sm:p-5 hover:bg-slate-850/50 transition-colors flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 cursor-pointer group"
                data-program-id={prog.id}
                data-title={prog.title}
                data-desc={prog.description}
                data-category={prog.category}
                data-imdb={prog.imdb_rating}
                data-start={prog.start_time}
                data-end={prog.end_time}
                data-rating={prog.rating}
                data-image={cleanImg}
                data-channel-slug={slug}
                data-channel-name={channel.name}
                data-channel-number={channel.number}
                data-channel-logo={channel.logo}
                data-bvod-name={channel.bvodPlatform}
                data-stream-url={channel.streamUrl}
                onclick="openProgramModal(this)"
              >
                <!-- Time & Info -->
                <div class="flex items-start gap-4 flex-1">
                  <div class="text-left shrink-0">
                    <span class="text-sm sm:text-base font-mono font-bold text-amber-400 block">
                      {timeFormatted}
                    </span>
                    <span class="text-[11px] text-slate-500 font-mono">
                      to {endTimeFormatted}
                    </span>
                  </div>

                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      {prog.category && (
                        <span class="text-[10px] font-semibold text-slate-300 bg-slate-800 px-2 py-0.5 rounded border border-slate-700/60">
                          {prog.category}
                        </span>
                      )}

                      {prog.imdb_rating && (
                        <span class="text-[10px] font-extrabold text-amber-400 bg-amber-400/10 px-1.5 py-0.5 rounded border border-amber-400/30">
                          ⭐ {prog.imdb_rating} IMDb
                        </span>
                      )}

                      {watershed && (
                        <span class="text-[10px] font-bold text-purple-400 bg-purple-500/10 px-1.5 py-0.5 rounded border border-purple-500/20">
                          Post-9pm
                        </span>
                      )}
                    </div>

                    <h2 class="text-base sm:text-lg font-bold text-white group-hover:text-amber-300 transition-colors">
                      {prog.title}
                    </h2>

                    {prog.sub_title && (
                      <p class="text-xs font-medium text-amber-300/80 mt-0.5">
                        {prog.sub_title}
                      </p>
                    )}

                    <p class="text-xs text-slate-400 line-clamp-2 mt-1 leading-relaxed">
                      {prog.description || 'Broadcasting on Freeview.'}
                    </p>
                  </div>
                </div>

                <!-- Thumbnail -->
                {cleanImg && (
                  <div class="w-20 h-14 rounded-lg overflow-hidden bg-slate-800 flex-shrink-0 self-end sm:self-center relative flex items-center justify-center">
                    <span class="absolute text-xs opacity-20 select-none">📺</span>
                    <img 
                      src={cleanImg} 
                      alt={prog.title} 
                      class="w-full h-full object-cover relative z-10" 
                      loading="lazy" 
                      referrerpolicy="no-referrer"
                      onerror={`if (!this.src.endsWith('${fallbackImg}')) { this.src = '${fallbackImg}'; } else { this.style.display = 'none'; }`}
                    />
                  </div>
                )}
              </div>
            );
          })
        )}
      </div>
    </div>

  </main>

  <ProgramOverlay />
  <MoodPickerModal />
  <Footer />
</BaseLayout>
